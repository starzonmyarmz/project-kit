name: Check

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: check-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v7
      - run: swift format lint --strict --recursive Package.swift Sources Tests scripts/make-icon.swift
      - run: swift test
