name: Feature request
description: Suggest an improvement to {{ display_name }}.
labels: [enhancement]
body:
  - type: textarea
    id: problem
    attributes:
      label: What are you trying to do?
      description: Describe the task that's harder than it should be.
    validations:
      required: true
  - type: textarea
    id: idea
    attributes:
      label: What would help?
      description: How you'd like it to work. Mention another app if it does this well.
    validations:
      required: true
  - type: textarea
    id: workaround
    attributes:
      label: How do you do it today?
