{% if stack == 'rust-plugin' -%}
read_version() {
  sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1
}

write_version() {
  sed -i '' "s/^version = \".*\"/version = \"$1\"/" Cargo.toml
  cargo update --workspace --quiet
}
{%- else -%}
read_version() {
  git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null | sed 's/^v//' || echo 0.0.0
}

write_version() {
  :
}
{%- endif %}
