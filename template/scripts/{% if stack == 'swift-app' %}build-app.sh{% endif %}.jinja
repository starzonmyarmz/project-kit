#!/bin/bash
# Usage: scripts/build-app.sh [version]
# Builds "dist/{{ display_name }}.app" and dist/{{ name }}-<version>.zip. Signs with $SIGN_IDENTITY
# (a certificate name or SHA-1 hash), else a "{{ display_name }} Local" certificate in the keychain,
# else ad hoc.
set -euo pipefail

VERSION="${1:-0.0.0-dev}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIST="$ROOT/dist"
APP="$DIST/{{ display_name }}.app"

cd "$ROOT"
if [[ -z ${SIGN_IDENTITY:-} ]] && security find-identity -p codesigning | grep -qF '"{{ display_name }} Local"'; then
  SIGN_IDENTITY="{{ display_name }} Local"
fi
{%- if xcodegen %}
command -v xcodegen >/dev/null || { echo "build-app: xcodegen is missing (brew install xcodegen)" >&2; exit 1; }
xcodegen generate --quiet
xcodebuild -project {{ type_name }}.xcodeproj -scheme {{ type_name }} -configuration Release \
  -derivedDataPath .build/xcode -skipPackagePluginValidation -quiet \
  MARKETING_VERSION="$VERSION" CURRENT_PROJECT_VERSION="$(git rev-list --count HEAD)" build

rm -rf "$DIST"
mkdir -p "$DIST"
ditto ".build/xcode/Build/Products/Release/{{ type_name }}.app" "$APP"

codesign --force --preserve-metadata=entitlements,flags \
  ${SIGN_KEYCHAIN:+--keychain "$SIGN_KEYCHAIN"} \
  --sign "${SIGN_IDENTITY:--}" "$APP"
{%- else %}
swift build -c release
BIN="$(swift build -c release --show-bin-path)/{{ type_name }}"

rm -rf "$DIST"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN" "$APP/Contents/MacOS/{{ type_name }}"
sed -e "s/@VERSION@/$VERSION/g" -e "s/@BUILD@/$(git rev-list --count HEAD)/g" packaging/Info.plist > "$APP/Contents/Info.plist"

ICONSET="$DIST/AppIcon.iconset"
swift scripts/make-icon.swift packaging/icon.svg "$ICONSET"
iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/AppIcon.icns"
rm -rf "$ICONSET"

codesign --force --options runtime --timestamp=none \
  ${SIGN_KEYCHAIN:+--keychain "$SIGN_KEYCHAIN"} \
  --sign "${SIGN_IDENTITY:--}" "$APP"
{%- endif %}
codesign --verify --strict "$APP"

ditto -c -k --keepParent "$APP" "$DIST/{{ name }}-$VERSION.zip"
echo "$DIST/{{ name }}-$VERSION.zip"
