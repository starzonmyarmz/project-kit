#!/bin/bash
# Builds the app as <last release>-dev, replaces /Applications/{{ display_name }}.app and opens it.
# Set SIGN_IDENTITY to your long-lived local certificate so permissions survive reinstalls.
set -euo pipefail
cd "$(dirname "$0")/.."

source scripts/version.sh
version="$(read_version)-dev"

scripts/build-app.sh "$version" >/dev/null
{%- if xcodegen %}
osascript -e 'if application id "{{ app_id }}" is running then tell application id "{{ app_id }}" to quit'
while pgrep -xq {{ type_name }}; do sleep 0.2; done
rm -rf "/Applications/{{ display_name }}.app"
ditto "dist/{{ display_name }}.app" "/Applications/{{ display_name }}.app"
if [ -x scripts/install-extra.sh ]; then
  scripts/install-extra.sh
fi
{%- else %}
osascript -e 'tell application id "{{ app_id }}" to quit' 2>/dev/null || true
rm -rf "/Applications/{{ display_name }}.app"
ditto "dist/{{ display_name }}.app" "/Applications/{{ display_name }}.app"
{%- endif %}
open "/Applications/{{ display_name }}.app"
echo "Installed {{ display_name }} $version ($(git rev-list --count HEAD))"
