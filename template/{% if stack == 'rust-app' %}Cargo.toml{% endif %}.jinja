[workspace]
resolver = "3"

[workspace.package]
version = "0.0.0"

[package]
name = "{{ name }}"
version.workspace = true
edition = "2024"

[[bin]]
name = "{{ type_name }}"
path = "src/main.rs"

[dependencies]
bevy = { version = "0.20", default-features = false, features = [
    "default_app",
    "std",
    "multi_threaded",
    "bevy_winit",
    "x11",
    "wayland",
    "bevy_render",
    "bevy_core_pipeline",
    "bevy_post_process",
    "bevy_pbr",
    "bevy_gizmos_render",
    "png",
    "tonemapping_luts",
] }
bevy_egui = { version = "0.43", default-features = false, features = [
    "manage_clipboard",
    "open_url",
    "default_fonts",
    "render",
] }

[features]
# Link Bevy as a shared library for faster rebuilds: `cargo run --features dev`.
dev = ["bevy/dynamic_linking"]

[profile.dev]
opt-level = 1

[profile.release]
lto = "thin"
codegen-units = 1
strip = "symbols"

[package.metadata.bundle]
name = "{{ display_name }}"
identifier = "{{ app_id }}"
category = "public.app-category.developer-tools"
short_description = "{{ description }}"
