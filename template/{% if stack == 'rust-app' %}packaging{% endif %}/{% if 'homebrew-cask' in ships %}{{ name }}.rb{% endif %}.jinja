cask "{{ name }}" do
  version "@VERSION@"
  sha256 "@SHA256:{{ name }}-@VERSION@-macos.zip@"

  url "https://github.com/{{ owner }}/{{ name }}/releases/download/v#{version}/{{ name }}-#{version}-macos.zip"
  name "{{ display_name }}"
  desc "{{ description }}"
  homepage "https://github.com/{{ owner }}/{{ name }}"

  app "{{ display_name }}.app"

  postflight_steps do
    run "/usr/bin/xattr",
        args:           ["-dr", "com.apple.quarantine", "{{ '{{' }}appdir{{ '}}' }}/{{ display_name }}.app"],
        writable_paths: ["{{ display_name }}.app"],
        writable_base:  :appdir
  end

  uninstall quit: "{{ app_id }}"
end
